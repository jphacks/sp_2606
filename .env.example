# 実値は .env.local に保存。管理用キーは通常操作には不要です。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# openssl rand -base64 32 で生成した32バイト鍵。サーバー専用。
SESSION_ENCRYPTION_KEY=
# 本番は実際の https URL。開発は http://localhost:3000 など。
APP_ORIGIN=http://127.0.0.1:3000
# 登録受付はクラウド側Authの制限確認後にtrueへ
ALLOW_SIGNUP=false

# 任意MFAのメール復旧専用。通常の投稿・DMでは使用しない。NEXT_PUBLIC_を付けない。
SUPABASE_RECOVERY_SECRET_KEY=
RECOVERY_SMTP_HOST=smtp.gmail.com
RECOVERY_SMTP_PORT=465
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASSWORD=
RECOVERY_MAIL_FROM=

# インシデント時だけ変更する。変更後は対象環境の再デプロイが必要。
# none:通常 / recovery:メール復旧と復旧用管理クライアント停止 / all:アプリを503で停止
COSTEP_INCIDENT_MODE=none
# このUTC日時より前に作成されたアプリのログインを拒否。通常は空欄。
# 鍵・Supabaseトークンの失効とは別。漏洩した暗号鍵は必ず交換する。
SESSION_NOT_BEFORE=
# SQL 0024適用後にtrueへ。本番値・個人情報を記録せず認証結果の件数だけ集計する。
SECURITY_METRICS_ENABLED=false
